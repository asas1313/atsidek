atsidek.eu {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# AI asistentas (atskiras Python servisas) – tik formos veiksmas (rezultato fragmentas); puslapį rodo app
	@assistant path /asistentas
	handle @assistant {
		reverse_proxy assistant:8000
	}
	handle {
		reverse_proxy app:8080
	}
}

www.atsidek.eu {
	redir https://atsidek.eu{uri} permanent
}
