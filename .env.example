# Kopijuok į .env (lokaliai / vienas serveris) arba /opt/atsidek/<aplinka>.env (deploy.sh).
# Failo NIEKADA nedėk į git. Production: chmod 600.

# --- Privalomi (privatumo politika) ---
CONTROLLER_NAME="Vardas Pavardė, IV pažyma Nr. XXXXXXX"
CONTACT_EMAIL="info@atsidek.eu"

# --- Aplinka / tinklas ---
CANONICAL_HOST=atsidek.eu      # kitais host'ais nukreipia į šį
NOINDEX=false                  # staging: true (paieškos neindeksuoja)
APP_BIND=127.0.0.1             # 0.0.0.0 jei prieš tai stovi Nginx Proxy Manager
APP_PORT=8080
IMAGE_TAG=local                # deploy.sh nustato pats (git SHA)
TUNNEL_TOKEN=                  # tik su --profile tunnel (Cloudflare)

# --- Duomenų bazė (PostgreSQL; nuo F0 fazės – ne H2) ---
DATA_DIR=./data                # tik banko išrašų/kitų failų katalogas, DB jame NEBĖRA
# Lokaliam dev (docker-compose "postgres" servisas) – numatytosios reikšmės žemiau tinka be pakeitimų.
# Staging/production: DB_URL/DB_USER/DB_PASSWORD NUSTATO deploy aplinka (atskiras Postgres LXC
# serveris 192.168.68.106:5432, duomenų bazės atsidek_staging/atsidek_prod) – žr. DEPLOY.md.
# Niekada nerašyti realių staging/prod prisijungimo duomenų į šį failą ar į git.
# DB_URL=jdbc:postgresql://postgres:5432/atsidek
DB_NAME=atsidek
DB_USER=atsidek
DB_PASSWORD=atsidek

# --- Banko išrašai (papildinys 01) ---
BANK_IBAN_SALT=                # atsitiktinė druska (openssl rand -hex 32); vėliau NEKEISTI

# --- JSON API (/api/**, AI asistentui) – apsaugotas API raktu, ne Google ---
# Raktą sugeneruok: python ai/naujas_raktas.py (raktas lieka ai/.env, čia dedama tik jo SHA-256 maiša).
# Kelios maišos – kableliais. Tuščia = API uždarytas (401).
API_KEY_HASHES=
# Pats raktas (ne maiša) – AI asistento servisui, kuris kviečia /api/v1/compare:
ATSIDEK_API_KEY=

# --- Prisijungimas (Google OAuth) ---
GOOGLE_CLIENT_ID=             # Google Cloud Console -> Google Auth Platform -> Clients
GOOGLE_CLIENT_SECRET=
AUTH_OWNER_EMAIL=             # šis el. paštas perima senus "local" duomenis
AUTH_ALLOWED_EMAILS=          # kableliais; tuščia = visi patvirtinti Google el. paštai

# --- AI asistentas (atskiras Python servisas assistant/, pagrindinis puslapis /, viešas) ---
ASSISTANT_PORT=8000
ANTHROPIC_API_KEY=            # tuščia = asistentas rodo klaidą
AI_MODEL=claude-haiku-5-5
AI_RATE_LIMIT_PER_HOUR=10     # užklausų per valandą vienam IP (/asistentas, IV mokesčiai)
AI_DAILY_CAP=300              # bendras užklausų per parą limitas (kainos apsauga, /asistentas)
GOALS_AI_DAILY_LIMIT=500      # globalus (BE per-IP) dienos limitas /api/v1/goals/parse (+ explain)
